<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>mtd</string>
	<key>CFBundleDisplayName</key>
	<string>Meeting Listener</string>
	<key>CFBundleExecutable</key>
	<string>mtd</string>

	<!-- macOS ties a privacy grant to this identifier. Change it and every
	     permission is asked for again, or silently refused while the daemon
	     records silence. It is fixed, for good. -->
	<key>CFBundleIdentifier</key>
	<string>com.dmykolen.mtd</string>

	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- Core Audio process taps arrived in macOS 14.2. -->
	<key>LSMinimumSystemVersion</key>
	<string>14.2</string>

	<!-- A background listener with a tray icon, not a windowed app. -->
	<key>LSUIElement</key>
	<true/>

	<key>NSMicrophoneUsageDescription</key>
	<string>Records your voice so meetings can be transcribed on this machine.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Records what the other participants say, so a meeting transcript is not just your half of it.</string>
</dict>
</plist>
