# Every setting is optional; the values below are the defaults.
# A blank value means "not set" and falls back to the default.

# --- storage and roles --------------------------------------------------------
MT_DATABASE_URL=sqlite:///data/jobs.db
# For several machines: postgresql+psycopg://user:pass@host/meetings
#   uv sync --extra postgres
MT_MEDIA_DIR=data/media

# all | api | worker. "all" runs the API and a worker together. Split them to add
# transcription capacity; every process needs the same database and media volume.
MT_ROLE=all
MT_CONCURRENCY=1
MT_POLL_INTERVAL=2
# A job whose worker stops sending heartbeats for this long is taken over.
MT_LEASE_SECONDS=300
MT_MAX_ATTEMPTS=3
# Days a recording stays on disk for playback. 0 deletes it as soon as the job ends.
MT_KEEP_MEDIA_DAYS=7
MT_MAX_UPLOAD_MB=4096

# --- models -------------------------------------------------------------------
# Required for the gated pyannote pipelines. A token is not enough on its own: the
# account it belongs to has to accept the conditions on BOTH of these pages, and
# the second one is the half people miss because it is only a dependency.
#   https://huggingface.co/pyannote/speaker-diarization-community-1
#   https://huggingface.co/pyannote/segmentation-3.0
# Then create a read token at https://huggingface.co/settings/tokens
MT_HF_TOKEN=

# Where downloaded weights are kept between runs. Leave empty for
# ~/.cache/huggingface; point it at a volume so a rebuild does not re-download
# several gigabytes. The startup log prints the path and how much is cached.
MT_MODEL_CACHE=

MT_WHISPER_MODEL=large-v3-turbo
# The model behind live captions. Empty means the same one. A smaller model sounds
# like the obvious way to cut live latency and measured worse on this hardware: a
# weak model loops on long utterances, so it ends up slower AND less accurate. If
# you do set one, the recording is queued for a proper pass once the session ends.
MT_LIVE_MODEL=
MT_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# auto | cpu | cuda
MT_DEVICE=auto
# CTranslate2 quantization. Empty means float16 on GPU, int8 on CPU.
MT_COMPUTE_TYPE=
# Windows decoded together. Only used on a GPU, where it is a large speed-up.
MT_BATCH_SIZE=8
# Load the models during startup instead of on the first job. Either way the API
# answers immediately; this only decides when the wait happens.
MT_PRELOAD_MODELS=false

# --- transcription quality ----------------------------------------------------
# ISO code such as en or uk. Empty means auto-detect.
MT_LANGUAGE=
# Names, products and acronyms every transcription should expect.
MT_VOCABULARY=
# One VAD pass removes silence before either model sees the audio.
MT_TRIM_SILENCE=true
# Whisper invents sentences over silence; these two thresholds discard them.
MT_DROP_NO_SPEECH_ABOVE=0.8
MT_DROP_LOGPROB_BELOW=-1.0

# --- speakers -----------------------------------------------------------------
# Cosine similarity above which two voice samples count as the same person.
MT_SPEAKER_MATCH_THRESHOLD=0.55

# --- summaries, search and sharing --------------------------------------------
MT_LLM_PROVIDER=openai
MT_LLM_MODEL=gpt-5-mini
# Falls back to OPENAI_API_KEY / ANTHROPIC_API_KEY when unset.
MT_LLM_API_KEY=
# OpenAI embeddings power semantic search; without them search falls back to keywords.
MT_EMBEDDING_MODEL=text-embedding-3-small
MT_SEARCH_RESULTS=8
MT_SHARE_DAYS=14
